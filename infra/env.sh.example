# infra/env.sh — copy from env.sh.example and edit. NEVER commit env.sh (gitignored).
# Sourced by every infra/scripts/*.sh via lib.sh. Names follow BACKBONE §10.

# --- Credentials -------------------------------------------------------------
# Local machine: set the AWS CLI profile you configured (`aws configure --profile <name>`).
# CloudShell: leave AWS_PROFILE empty — CloudShell already has credentials.
export AWS_PROFILE="${AWS_PROFILE:-}"
[ -z "$AWS_PROFILE" ] && unset AWS_PROFILE

# --- Region (BACKBONE §10.1, decision D1) --------------------------------------
export AWS_REGION="${AWS_REGION:-ap-south-1}"   # D1 decided 2026-10-08: Mumbai (Bedrock via global inference profiles)
export AWS_DEFAULT_REGION="$AWS_REGION"
export AQUA_REGION="$AWS_REGION"

# --- Account (auto via STS; never hard-code) ----------------------------------
ACCOUNT_ID="${ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text 2>/dev/null || echo UNKNOWN)}"
export ACCOUNT_ID

# --- Names (BACKBONE §3.2, §10) ------------------------------------------------
export PROJECT_TAG_KEY="project"
export PROJECT_TAG_VALUE="aquaagent"
export AQUA_BUCKET="aquaagent-${ACCOUNT_ID}-${AWS_REGION}"
export ECR_REPO_SIM="aquaagent-sim"
export ECR_REPO_API="aquaagent-api"
export ECR_REPO_PREDICTOR="aquaagent-predictor"   # BI-26: §7.9 predictor service container
export ECS_CLUSTER="aquaagent"
export ECS_SERVICE="aquaagent-api"
export TASKDEF_FAMILY_SERVE="aquaagent-serve"
export TASKDEF_FAMILY_DATAGEN="aquaagent-datagen"
export TASKDEF_FAMILY_SERVE_TEST="aquaagent-serve-test"   # script 16: one-off test task (no ALB, no SSM)
export LOG_GROUP_API="/ecs/aquaagent-api"
export LOG_GROUP_SIM="/ecs/aquaagent-sim"
export LOG_GROUP_DATAGEN="/ecs/aquaagent-datagen"
export LOG_GROUP_PREDICTOR="/ecs/aquaagent-predictor"
export ALB_NAME="aquaagent-alb"
export TG_NAME="aquaagent-api-tg"
export SG_ALB_NAME="aquaagent-alb-sg"
export SG_TASK_NAME="aquaagent-task-sg"
export SG_TEST_NAME="aquaagent-test-sg"   # script 16: 8080/8001 from the operator IP only
export APIGW_NAME="aquaagent-http"
export SSM_PREFIX="/aquaagent"
export AMPLIFY_APP_NAME="aquaagent"
export AMPLIFY_BRANCH="main"
export CODEBUILD_PROJECT="aquaagent-image-build"
export BUDGET_NAME="aquaagent-budget"

# IAM roles (BACKBONE §10.3 + BI-10 optional codebuild role)
export ROLE_ECS_EXEC="aqua-ecs-exec"
export ROLE_SIM_TASK="aqua-sim-task"
export ROLE_API_TASK="aqua-api-task"
export ROLE_SAGEMAKER_EXEC="aqua-sagemaker-exec"
export ROLE_CODEBUILD="aqua-codebuild"

# --- Runtime (BACKBONE §10.4) ---------------------------------------------------
export AQUA_NETWORK_ID="net_epa_tutorial_v1"
export AQUA_SENSOR_LAYOUT_ID="sensors_default_v1"
export AQUA_PREDICTOR_ENDPOINT="aquaagent-predictor"
export AQUA_DATASET_VERSION="ds1"
export DATAGEN_NUM_SHARDS="${DATAGEN_NUM_SHARDS:-4}"   # 1,200 sims / 4 shards on Fargate Spot

# --- Budget (BACKBONE §10.5) ----------------------------------------------------
export BUDGET_LIMIT_USD="${BUDGET_LIMIT_USD:-10}"
export BUDGET_EMAIL="${BUDGET_EMAIL:-}"          # REQUIRED for 01_budget_alert.sh

# --- Values to confirm before running (<VERIFY>, see docs/RUNBOOK.md) -----------
export AQUA_SM_TRAIN_INSTANCE="${AQUA_SM_TRAIN_INSTANCE:-}"   # <VERIFY: CPU training instance type, e.g. an ml.m5 size>
export AQUA_SM_INFER_INSTANCE="${AQUA_SM_INFER_INSTANCE:-}"   # <VERIFY: smallest real-time instance passing G6 p95 < 300 ms>
export AQUA_SM_PT_VERSION="${AQUA_SM_PT_VERSION:-}"           # <VERIFY: PyTorch framework version supported by SageMaker SDK image_uris>
export AQUA_SM_PY_VERSION="${AQUA_SM_PY_VERSION:-}"           # <VERIFY: matching py version, e.g. py3xx>
export AQUA_BEDROCK_MODEL_ID="${AQUA_BEDROCK_MODEL_ID:-}"     # <VERIFY: discovered by 14_bedrock_check.sh; model id OR inference-profile id (BI-05)>
export CODEBUILD_IMAGE="${CODEBUILD_IMAGE:-}"                 # <VERIFY: current aws/codebuild/standard:<n> image>
export APIGW_THROTTLE_BURST="${APIGW_THROTTLE_BURST:-}"       # <VERIFY: burst limit for demo traffic (BI-13)>
export APIGW_THROTTLE_RATE="${APIGW_THROTTLE_RATE:-}"         # <VERIFY: steady rate limit for demo traffic (BI-13)>
export ECS_TASK_CPU="${ECS_TASK_CPU:-2048}"                   # D10 raised: 2 vCPU for sim + api + predictor + detector
export ECS_TASK_MEMORY="${ECS_TASK_MEMORY:-4096}"             # D10 raised: 4 GB (two torch model services)

# Optional: GitHub token for non-interactive Amplify connect (else MANUAL STEP in 15_amplify_app.sh)
export GITHUB_REPO_URL="${GITHUB_REPO_URL:-}"
