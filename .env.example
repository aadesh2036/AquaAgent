# Copy to .env for local runs (never commit .env). Canonical names: BACKBONE §10.4.
AQUA_MODE=local
AQUA_REGION=us-east-1
AQUA_BUCKET=
AQUA_NETWORK_ID=net_epa_tutorial_v1
AQUA_SENSOR_LAYOUT_ID=sensors_default_v1
AQUA_SIM_URL=http://localhost:8000
AQUA_PREDICTOR_ENDPOINT=aquaagent-predictor
AQUA_PREDICTOR_VERSION=
AQUA_PREDICTOR_ARTIFACT=data/models/predictor/<model_version>
AQUA_THRESHOLDS_URI=data/models/anomaly/<thresholds_version>   # detector artifact dir (or s3://…/models/anomaly/<v>/)
AQUA_SIGNATURES_URI=data/models/localisation/<signatures_version>
# AQUA_PREDICTOR_URL=http://localhost:8001   # use the predictor container instead of in-process (BI-26)
# AQUA_DETECTOR_URL=http://localhost:8002    # use the detector container instead of in-process (BI-27)
AQUA_AGENT=template
AQUA_BEDROCK_MODEL_ID=
AQUA_API_KEY=
AQUA_CORS_ORIGINS=http://localhost:5173
